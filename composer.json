{
	"name": "rtcamp/plugin-skeleton-d",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.2"
		},
		"preferred-install": "dist",
		"process-timeout": 0,
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "rtCamp\\Plugin_Skeleton_D\\Vendor\\",
			"classmap_prefix": "Plugin_Skeleton_D_Vendor_",
			"constant_prefix": "PLUGIN_SKELETON_D_VENDOR_",
			"update_call_sites": false,
			"delete_vendor_packages": true,
			"packages": [
				"rtcamp/wp-primitives"
			]
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"rtCamp\\Plugin_Skeleton_D\\": "inc/",
			"rtCamp\\Plugin_Skeleton_D\\Framework\\": "framework/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"rtCamp\\Plugin_Skeleton_D\\Tests\\": "tests/phpunit/"
		}
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/rtCamp/coding-standards-d.git"
		}
	],
	"require": {
		"php": "^8.2",
		"rtcamp/wp-primitives": "^2.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/wordpress-stubs": "7.1.2 as 6.9.4",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^2.3.5",
		"phpstan/phpstan-deprecation-rules": "^2.0.5",
		"phpstan/phpstan-phpunit": "^2.1.2",
		"phpunit/phpunit": "^11.5",
		"rtcamp/coding-standards-d": "^0.1.1",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"clean": "rm -rf vendor vendor-prefixed",
		"format": "phpcbf",
		"lint": "phpcs",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "vendor/bin/phpunit -c phpunit.xml.dist",
		"test-multisite": "WP_MULTISITE=1 phpunit --exclude-group=ms-excluded",
		"prefix-namespaces": [
			"sh -c 'test -d vendor-prefixed || mkdir vendor-prefixed'",
			"sh -c 'test -f ./tests/_output/strauss.phar || curl -o ./tests/_output/strauss.phar -L -C - https://github.com/BrianHenryIE/strauss/releases/download/0.31.1/strauss.phar'",
			"@php ./tests/_output/strauss.phar",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		]
	}
}
